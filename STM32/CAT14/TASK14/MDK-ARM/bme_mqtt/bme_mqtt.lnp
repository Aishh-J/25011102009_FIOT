--cpu Cortex-M3
"bme_mqtt\startup_stm32f103xb.o"
"bme_mqtt\main.o"
"bme_mqtt\stm32f1xx_it.o"
"bme_mqtt\stm32f1xx_hal_msp.o"
"bme_mqtt\esplib.o"
"bme_mqtt\bme280.o"
"bme_mqtt\stm32f1xx_hal_gpio_ex.o"
"bme_mqtt\stm32f1xx_hal_i2c.o"
"bme_mqtt\stm32f1xx_hal.o"
"bme_mqtt\stm32f1xx_hal_rcc.o"
"bme_mqtt\stm32f1xx_hal_rcc_ex.o"
"bme_mqtt\stm32f1xx_hal_gpio.o"
"bme_mqtt\stm32f1xx_hal_dma.o"
"bme_mqtt\stm32f1xx_hal_cortex.o"
"bme_mqtt\stm32f1xx_hal_pwr.o"
"bme_mqtt\stm32f1xx_hal_flash.o"
"bme_mqtt\stm32f1xx_hal_flash_ex.o"
"bme_mqtt\stm32f1xx_hal_exti.o"
"bme_mqtt\stm32f1xx_hal_uart.o"
"bme_mqtt\system_stm32f1xx.o"
--strict --scatter "bme_mqtt\bme_mqtt.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "bme_mqtt.map" -o bme_mqtt\bme_mqtt.axf