"task-10c\stm32f1xx_hal_uart.o"
"task-10c\stm32f1xx_hal.o"
"task-10c\stm32f1xx_hal_rcc.o"
"task-10c\stm32f1xx_hal_rcc_ex.o"
"task-10c\stm32f1xx_hal_gpio.o"
"task-10c\stm32f1xx_hal_dma.o"
