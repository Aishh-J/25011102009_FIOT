--cpu Cortex-M3
"task\startup_stm32f103xb.o"
"task\main.o"
"task\stm32f1xx_it.o"
"task\stm32f1xx_hal_msp.o"
"task\stm32f1xx_hal_gpio_ex.o"
"task\stm32f1xx_hal_uart.o"
"task\stm32f1xx_hal.o"
"task\stm32f1xx_hal_rcc.o"
"task\stm32f1xx_hal_rcc_ex.o"
"task\stm32f1xx_hal_gpio.o"
"task\stm32f1xx_hal_dma.o"
"task\stm32f1xx_hal_cortex.o"
"task\stm32f1xx_hal_pwr.o"
"task\stm32f1xx_hal_flash.o"
"task\stm32f1xx_hal_flash_ex.o"
"task\stm32f1xx_hal_exti.o"
"task\system_stm32f1xx.o"
--strict --scatter "task\task.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "task.map" -o task\task.axf