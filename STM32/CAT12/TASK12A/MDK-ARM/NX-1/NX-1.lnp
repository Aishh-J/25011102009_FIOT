--cpu=Cortex-M4.fp.sp
"nx-1\startup_stm32f401xe.o"
"nx-1\main.o"
"nx-1\stm32f4xx_it.o"
"nx-1\stm32f4xx_hal_msp.o"
"nx-1\stm32f4xx_hal_uart.o"
"nx-1\stm32f4xx_hal_rcc.o"
"nx-1\stm32f4xx_hal_rcc_ex.o"
