"nx-1\stm32f4xx_hal_flash_ex.o"
"nx-1\stm32f4xx_hal_flash_ramfunc.o"
"nx-1\stm32f4xx_hal_gpio.o"
"nx-1\stm32f4xx_hal_dma_ex.o"
"nx-1\stm32f4xx_hal_dma.o"
"nx-1\stm32f4xx_hal_pwr.o"
