--cpu=Cortex-M4.fp.sp
"nucleo_demo\startup_stm32f401xe.o"
"nucleo_demo\main.o"
"nucleo_demo\stm32f4xx_it.o"
"nucleo_demo\stm32f4xx_hal_msp.o"
"nucleo_demo\stm32f4xx_hal_uart.o"
"nucleo_demo\stm32f4xx_hal_rcc.o"
"nucleo_demo\stm32f4xx_hal_rcc_ex.o"
"nucleo_demo\stm32f4xx_hal_flash.o"
"nucleo_demo\stm32f4xx_hal_flash_ex.o"
"nucleo_demo\stm32f4xx_hal_flash_ramfunc.o"
"nucleo_demo\stm32f4xx_hal_gpio.o"
"nucleo_demo\stm32f4xx_hal_dma_ex.o"
"nucleo_demo\stm32f4xx_hal_dma.o"
"nucleo_demo\stm32f4xx_hal_pwr.o"
"nucleo_demo\stm32f4xx_hal_pwr_ex.o"
"nucleo_demo\stm32f4xx_hal_cortex.o"
"nucleo_demo\stm32f4xx_hal.o"
"nucleo_demo\stm32f4xx_hal_exti.o"
"nucleo_demo\system_stm32f4xx.o"
--strict --scatter "Nucleo_demo\Nucleo_demo.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "Nucleo_demo.map" -o Nucleo_demo\Nucleo_demo.axf